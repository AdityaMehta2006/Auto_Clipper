# ─────────────────────────────────────────────────────────
# Auto Clipper — Environment Configuration
# Copy this to .env and fill in the values.
# ─────────────────────────────────────────────────────────

# ── Auth ──────────────────────────────────────────────
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ── Google OAuth (required for Google Drive data source) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# ── Gemini AI ──────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── Data Source ────────────────────────────────────────
# Options: google_drive | local
DATA_SOURCE=local
# Only needed when DATA_SOURCE=google_drive
GDRIVE_ROOT_FOLDER_ID=

# ── Database ───────────────────────────────────────────
# SQLite for dev; swap for postgresql:// in production
DATABASE_URL=sqlite:///./data/auto_clipper.db

# ── Storage Paths (relative to backend/ dir by default) ──
DOWNLOADS_DIR=./data/downloads
CLIPS_DIR=./data/clips
DATA_SOURCES_DIR=./data/DataSources
# Folder containing subfolders with raw video files
LOCAL_VIDEO_PATH=../vids

# ── FFmpeg ─────────────────────────────────────────────
# 'ffmpeg' if on PATH; otherwise provide absolute path
FFMPEG_PATH=ffmpeg

# ── Transcription (Whisper) ────────────────────────────
TRANSCRIPTION_MODEL_SIZE=base
# Device: cpu | cuda | mps
TRANSCRIPTION_DEVICE=cpu
# Compute type: int8 | float16 | float32
TRANSCRIPTION_COMPUTE_TYPE=int8

# ── CORS (comma-separated list of allowed origins) ─────
CORS_ORIGINS=http://localhost:5173
