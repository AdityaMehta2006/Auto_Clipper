# ─────────────────────────────────────────────────────────
# Auto Clipper — Environment Configuration
# Copy this to .env and fill in the values.
# ─────────────────────────────────────────────────────────

# ── Environment ───────────────────────────────────────
# "development" or "production"
ENVIRONMENT=development

# ── Supabase ──────────────────────────────────────────
# Get these from: Supabase Dashboard → Settings → API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE

# ── Database ───────────────────────────────────────────
# Supabase → Settings → Database → Connection string → URI
# Replace [YOUR-PASSWORD] with your database password
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# ── Auth ──────────────────────────────────────────────
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ── Google OAuth (optional — for Drive source) ────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# ── Gemini AI ──────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── Data Source ────────────────────────────────────────
# Options: google_drive | local
DATA_SOURCE=local
GDRIVE_ROOT_FOLDER_ID=
LOCAL_VIDEO_PATH=../vids

# ── Storage Paths ──────────────────────────────────────
DOWNLOADS_DIR=./data/downloads
CLIPS_DIR=./data/clips
DATA_SOURCES_DIR=./data/DataSources

# ── Transcription (Optional) ──────────────────────────
# Set to 'false' to disable local Whisper and require pre-made transcripts
TRANSCRIPTION_ENABLED=true
TRANSCRIPTION_MODEL_SIZE=base
TRANSCRIPTION_DEVICE=cpu
TRANSCRIPTION_COMPUTE_TYPE=int8

# ── FFmpeg ─────────────────────────────────────────────
FFMPEG_PATH=ffmpeg

# ── CORS ───────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173
